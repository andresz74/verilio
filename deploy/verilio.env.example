# Copy to /etc/verilio/verilio.env on the runtime host and set explicit values.
COMPOSE_PROJECT_NAME=verilio
VERILIO_VERSION=v0.1.0
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001
LOG_LEVEL=info
VERILIO_GATEWAY_PORT=8080
VERILIO_PGDATA_VOLUME=verilio_pgdata
VERILIO_BACKUP_DIR=/srv/verilio/backups
VERILIO_BACKUP_RETENTION_DAYS=7
VERILIO_DATABASE_URL_SECRET=/etc/verilio/secrets/database_url
VERILIO_POSTGRES_ADMIN_PASSWORD_SECRET=/etc/verilio/secrets/postgres_admin_password
VERILIO_POSTGRES_APP_PASSWORD_SECRET=/etc/verilio/secrets/postgres_app_password
