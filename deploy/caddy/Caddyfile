{
	auto_https off
	admin off
}

:8080 {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@backend path /api/* /health/*
	handle @backend {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/verilio

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@documents not path /assets/*
		header @documents Cache-Control "no-cache, no-store, must-revalidate"

		try_files {path} /index.html
		file_server
	}
}
